# SAP Integration Suite Configuration
SAP_TENANT_URL=https://your-tenant.authentication.sap.hana.ondemand.com
SAP_CLIENT_ID=your_client_id_here
SAP_CLIENT_SECRET=your_client_secret_here
# SAP_API_ENDPOINT=https://your-tenant.it-cpi012.cfapps.eu10.hana.ondemand.com (Optional if different)

# Proxy Settings (Uncomment if behind corporate proxy)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080

# TLS Settings (Uncomment if using self-signed certs/proxy)
# NODE_TLS_REJECT_UNAUTHORIZED=0
